# Optional. The site already knows its production domain (www.onemoregame.site),
# so this is only needed to point a build somewhere else — a staging host, or
# a local build you want to generate absolute production URLs.
# NEXT_PUBLIC_SITE_URL=https://staging.example.com

# Optional. The Google Tag Manager container to load. The production container
# is the default, so a normal deploy needs nothing here — set this only to point
# a build at a different container (a staging one, for example).
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
